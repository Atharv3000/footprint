# Footprint Cloud Environment Variables
# Copy to a local .env file (never commit .env to git) or configure via EAS / GitHub Secrets.

# 1. Supabase Cloud Database & Authentication (Publishable client config)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# 2. Cloud-Hosted Backend Service URL (Render / Railway / Cloud Run)
# Authentication uses per-user Supabase JWTs; never expose a static backend token in EXPO_PUBLIC_*.
EXPO_PUBLIC_REP_SERVER_URL=

# 3. Server-Side Only (set in Railway/Render/GitHub Secrets, NEVER in client EXPO_PUBLIC_*)
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
